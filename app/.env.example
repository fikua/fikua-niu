# Niu — env vars (real .env is gitignored)
# Copy this file to .env on the VPS host (/opt/vps/projects/niu/.env)
# and fill in real values. NEVER commit the filled-in file.

# Docker Hub registry / image
DOCKER_REGISTRY=fikua
NIU_VERSION=latest

# ── Real authentication (required starting NIU-4; leave blank until then) ──
# NIU_SESSION_SECRET must be >=32 bytes of high-entropy data, e.g.:
#   openssl rand -base64 32
NIU_SESSION_SECRET=

# Two users, generic placeholders per PLAN.md §1.1 / S11 (public repo —
# real names/emails never committed anywhere, including this file).
NIU_USER_A_NAME=
NIU_USER_A_DISPLAY=
# bcrypt hash (cost 12), never the plaintext password. Generate with the
# app's own hashing helper once NIU-4 ships, or:
#   htpasswd -bnBC 12 "" '<password>' | tr -d ':\n'
NIU_USER_A_HASH=

NIU_USER_B_NAME=
NIU_USER_B_DISPLAY=
NIU_USER_B_HASH=
